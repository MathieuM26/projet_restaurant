# Configuration Brevo (ex-Sendinblue) pour l'envoi d'emails transactionnels
# 1. Créez un compte gratuit sur https://www.brevo.com/
# 2. Allez dans SMTP & API -> Clés API -> Générer une nouvelle clé API
# 3. Copiez ce fichier sous le nom ".env" (dans le dossier back/) et renseignez vos valeurs :

BREVO_API_KEY=votre_cle_api_brevo_ici
BREVO_SENDER_EMAIL=votre_email_verifie_sur_brevo@exemple.be
BREVO_SENDER_NAME=Restaurant Le Gourmet
